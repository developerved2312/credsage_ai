# Database (Prisma 7)
# Connection pooling URL (e.g., via Prisma Accelerate or PgBouncer)
DATABASE_URL="postgresql://user:password@localhost:5432/credsage"

# Direct database connection for migrations (bypasses connection pooling)
# Use this for migrations, introspection, and Prisma Studio
DIRECT_URL="postgresql://user:password@localhost:5432/credsage"

# For production with connection pooling:
# DATABASE_URL="postgresql://user:password@pooler.example.com:6543/credsage?pgbouncer=true"
# DIRECT_URL="postgresql://user:password@postgres.example.com:5432/credsage"

# Server
PORT=3000
NODE_ENV="development"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-auth-key-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUST_HOST="true"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# External Services
ML_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# CORS
CORS_ORIGIN="http://localhost:5173"
