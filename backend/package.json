{
  "name": "backend",
  "version": "1.0.0",
  "description": "CredSage AI Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --config=./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config=./prisma.config.ts",
    "prisma:migrate:prod": "prisma migrate deploy --config=./prisma.config.ts",
    "prisma:studio": "prisma studio --config=./prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate --config=./prisma.config.ts",
    "prisma:format": "prisma format --config=./prisma.config.ts",
    "prisma:reset": "prisma migrate reset --config=./prisma.config.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "axios": "^1.6.5",
    "better-auth": "^1.6.23",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "prisma": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
